generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLOCKED
}

enum ConfessionStatus {
  ACTIVE
  HIDDEN
  REPORTED
  DELETED
}

enum CommentStatus {
  ACTIVE
  HIDDEN
  REPORTED
  DELETED
}

enum ReportTargetType {
  CONFESSION
  COMMENT
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum ModerationActionType {
  HIDE_CONTENT
  RESTORE_CONTENT
  DELETE_CONTENT
  DISMISS_REPORT
  WARN_USER
  SUSPEND_USER
}

model Role {
  id        String   @id @default(cuid())
  name      RoleName @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String?
  displayName       String
  isGuest           Boolean            @default(false)
  status            UserStatus         @default(ACTIVE)
  settings          Json?
  suspendedUntil    DateTime?
  lastLoginAt       DateTime?
  roleId            String
  role              Role               @relation(fields: [roleId], references: [id])
  refreshTokens     RefreshToken[]
  confessions       Confession[]
  ratings           ConfessionRating[]
  comments          Comment[]
  reports           Report[]
  moderationActions ModerationAction[] @relation("ModeratorActions")
  auditLogs         AuditLog[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  @@index([roleId])
  @@index([status])
}

model Category {
  id          String      @id
  slug        String      @unique
  name        String
  description String
  accentColor String
  communities Community[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("Category")
}

model Community {
  id               String       @id
  slug             String       @unique
  name             String
  city             String
  categoryId       String
  accentColor      String
  description      String
  headline         String
  isActive         Boolean      @default(true)
  category         Category     @relation(fields: [categoryId], references: [id])
  confessions      Confession[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  @@map("Section")
  @@index([categoryId, city])
}

model Confession {
  id              String              @id @default(cuid())
  publicSlug      String              @unique
  communityId     String              @map("sectionId")
  authorId        String?
  title           String?
  alias           String?
  isAnonymous     Boolean             @default(true)
  content         String
  status          ConfessionStatus    @default(ACTIVE)
  viewsCount      Int                 @default(0)
  averageRating   Decimal             @default(0) @db.Decimal(3, 2)
  ratingsCount    Int                 @default(0)
  commentsCount   Int                 @default(0)
  mediaMetadata   Json?
  moderationNotes String?
  publishedAt     DateTime?
  community       Community           @relation(fields: [communityId], references: [id])
  author          User?               @relation(fields: [authorId], references: [id])
  ratings         ConfessionRating[]
  comments        Comment[]
  reports         Report[]
  moderationLogs  ModerationAction[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  @@index([communityId, status, createdAt(sort: Desc)])
  @@index([status, averageRating(sort: Desc), ratingsCount(sort: Desc)])
  @@index([authorId])
}

model ConfessionRating {
  id           String     @id @default(cuid())
  confessionId String
  userId       String
  stars        Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  confession   Confession @relation(fields: [confessionId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@unique([confessionId, userId])
  @@index([confessionId, stars])
}

model Comment {
  id              String          @id @default(cuid())
  confessionId    String
  authorId        String?
  parentId        String?
  authorName      String?
  content         String
  status          CommentStatus   @default(ACTIVE)
  moderationNotes String?
  confession      Confession      @relation(fields: [confessionId], references: [id])
  author          User?           @relation(fields: [authorId], references: [id])
  parent          Comment?        @relation("CommentReplies", fields: [parentId], references: [id])
  replies         Comment[]       @relation("CommentReplies")
  reports         Report[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  @@index([confessionId, status, createdAt])
  @@index([parentId])
}

model Report {
  id                String             @id @default(cuid())
  reporterId        String?
  targetType        ReportTargetType
  targetId          String
  confessionId      String?
  commentId         String?
  reason            String
  details           String?
  status            ReportStatus       @default(OPEN)
  resolutionNotes   String?
  reviewedById      String?
  reviewedAt        DateTime?
  reporter          User?              @relation(fields: [reporterId], references: [id])
  confession        Confession?        @relation(fields: [confessionId], references: [id])
  comment           Comment?           @relation(fields: [commentId], references: [id])
  moderationAction  ModerationAction?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([targetType, targetId])
}

model ModerationAction {
  id               String               @id @default(cuid())
  reportId         String?              @unique
  confessionId     String?
  commentId        String?
  moderatorId      String
  actionType       ModerationActionType
  reason           String
  notes            String?
  report           Report?              @relation(fields: [reportId], references: [id])
  confession       Confession?          @relation(fields: [confessionId], references: [id])
  moderator        User                 @relation("ModeratorActions", fields: [moderatorId], references: [id])
  createdAt        DateTime             @default(now())

  @@index([moderatorId, createdAt(sort: Desc)])
}

model RefreshToken {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  entityType String
  entityId   String
  action     String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
}
