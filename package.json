{
  "name": "confessions-back",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready NestJS backend for a university confessions platform.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:local": "node scripts/run-with-env.mjs local nest start --watch",
    "start:dev": "node scripts/run-with-env.mjs dev nest start --watch",
    "start:cert": "node scripts/run-with-env.mjs cert nest start --watch",
    "start:prod": "node scripts/run-with-env.mjs prod node dist/src/main",
    "format": "prettier --write \"{src,prisma,test}/**/*.{ts,js,json,md,yml,yaml}\"",
    "lint": "eslint \"{src,prisma,test}/**/*.{ts,js}\" --max-warnings=0",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "validate:env:prod": "node scripts/validate-prod-env.mjs",
    "prepare": "husky",
    "prisma:generate": "prisma generate",
    "prisma:generate:local": "node scripts/run-with-env.mjs local prisma generate",
    "prisma:generate:dev": "node scripts/run-with-env.mjs dev prisma generate",
    "prisma:generate:cert": "node scripts/run-with-env.mjs cert prisma generate",
    "prisma:generate:prod": "node scripts/run-with-env.mjs prod prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:local": "node scripts/run-with-env.mjs local prisma migrate dev",
    "prisma:migrate:dev": "node scripts/run-with-env.mjs dev prisma migrate dev",
    "prisma:migrate:cert": "node scripts/run-with-env.mjs cert prisma migrate dev",
    "prisma:migrate:prod": "node scripts/run-with-env.mjs prod prisma migrate deploy",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:local": "node scripts/run-with-env.mjs local tsx prisma/seed.ts",
    "prisma:seed:dev": "node scripts/run-with-env.mjs dev tsx prisma/seed.ts",
    "prisma:seed:cert": "node scripts/run-with-env.mjs cert tsx prisma/seed.ts",
    "prisma:seed:prod": "node scripts/run-with-env.mjs prod tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "lint-staged": {
    "*.{ts,js,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "src/**/*.ts": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^11.0.7",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.7",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.3",
    "@nestjs/platform-express": "^11.0.7",
    "@nestjs/swagger": "^11.0.3",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.5.0",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.0.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3",
    "prisma": "^6.5.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  }
}
