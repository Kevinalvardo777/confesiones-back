NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1
APP_NAME=Confesiones EC API Local
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
SWAGGER_ENABLED=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/confessions_local?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_for_local
JWT_REFRESH_SECRET=replace_with_a_long_random_secret_for_local
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
AUTH_REFRESH_COOKIE_NAME=confesiones_ec_refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
THROTTLE_TTL=60
THROTTLE_LIMIT=25
MAX_PAYLOAD_SIZE=1mb
LOG_LEVEL=info
